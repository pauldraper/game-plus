{
  "compileOnSave": false,
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib"],
  "compilerOptions": {
    "declaration": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "noEmitOnError": true,
    "outDir": "lib",
    "strict": true,
    "sourceMap": true,
    "rootDir": "src",
    "target": "ES2022"
  }
}
